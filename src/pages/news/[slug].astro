---
import { render } from 'astro:content';
import type { GetStaticPaths } from 'astro';
import SiteLayout from '../../layouts/SiteLayout.astro';
import { getPublishedArticles, formatDate, type Article } from '../../lib/articles';
import { extractHeadings } from '../../lib/article-headings.mjs';

export const getStaticPaths = (async () => {
  const articles = await getPublishedArticles();
  return articles.map((article) => ({ params: { slug: article.id }, props: { article } }));
}) satisfies GetStaticPaths;

interface Props { article: Article; }
const { article } = Astro.props;
const { Content } = await render(article);
const headings = extractHeadings(article.body);
---

<SiteLayout title={article.data.title} description={article.data.description}
  image={article.data.image} imageAlt={article.data.imageAlt}
  publishedDate={article.data.date} mainClass="page-content article-page">
  <a class="back-link" href="/news/">← Alle nyheter</a>
  <div class:list={['article-layout', { 'article-layout-with-toc': headings.length > 0 }]}>
    {headings.length > 0 && (
      <aside class="article-toc" aria-label="Innhold på siden">
        <p class="article-toc-label">På denne siden</p>
        <nav>
          <ol>
            {headings.map((heading) => (
              <li class:list={{ 'article-toc-subitem': heading.depth === 3 }}>
                <a href={`#${heading.id}`}>{heading.text}</a>
              </li>
            ))}
          </ol>
        </nav>
      </aside>
    )}
    <article>
      <header class="article-heading">
        <time datetime={article.data.date}>{formatDate(article.data.date)}</time>
        <h1>{article.data.title}</h1>
        <p class="article-description">{article.data.description}</p>
      </header>
      <img class="article-image" src={article.data.image} alt={article.data.imageAlt} />
      {article.data.gallery.length > 0 && (
        <div class="article-gallery" aria-label="Bilder i artikkelen">
          {article.data.gallery.map((image, index) => (
            <img src={image} alt={`${article.data.title} – bilde ${index + 1}`} loading="lazy" />
          ))}
        </div>
      )}
      <div class="prose"><Content /></div>
    </article>
  </div>
  <div class="article-progress" aria-hidden="true"><span></span></div>
</SiteLayout>

<script>
  const progress = document.querySelector<HTMLElement>('.article-progress span');
  const article = document.querySelector<HTMLElement>('.article-page article');
  let frame = 0;
  const updateProgress = () => {
    frame = 0;
    if (!progress || !article) return;
    const bounds = article.getBoundingClientRect();
    const start = window.scrollY + bounds.top;
    const distance = Math.max(article.scrollHeight - window.innerHeight * 0.35, 1);
    const percentage = Math.min(100, Math.max(0, ((window.scrollY - start + 80) / distance) * 100));
    progress.style.width = `${percentage}%`;
  };
  window.addEventListener('scroll', () => {
    if (!frame) frame = requestAnimationFrame(updateProgress);
  }, { passive: true });
  window.addEventListener('resize', updateProgress);
  updateProgress();
</script>
