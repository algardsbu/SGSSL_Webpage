{
  "name": "sgssl",
  "version": "2.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "astro dev",
    "check": "node scripts/validate-content.mjs && astro check",
